       "fig.colorbar(surf1, shrink=0.5, aspect=5, label='u(x,y,T)')\n",
       "ax2 = fig.add_subplot(1, 2, 2, projection='3d')\n",
       "U_ex_final = u_ex_def(X_num, Y_num, Tf)\n",
       "surf2 = ax2.plot_surface(X_num, Y_num, U_ex_final, cmap=cm.viridis)\n",
       "ax2.set_title(f'Точное решение T={Tf:.2f}')\n",
       "ax2.set_xlabel('Координата x'); ax2.set_ylabel('Координата y'); ax2.set_zlabel('u(x,y,T)')\n",
       "fig.colorbar(surf2, shrink=0.5, aspect=5, label='u(x,y,T)')\n",
